# Copy to .env (gitignored - never commit it) and fill in. compose.yaml passes GATEWAY_TOKENS to
# the gateway and this whole file to the workers. Every variable is in the README.

# The gateway's bearer token(s), comma separated (rotation), 16+ characters each.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GATEWAY_TOKENS=

# The agent: openai | anthropic | google | openai-compatible (the providers this image installs).
AGENT_PROVIDER_TYPE=openai
AGENT_API_KEY=
AGENT_MODEL=gpt-4.1-mini
# AGENT_BASE_URL=              # required for openai-compatible
# AGENT_PLANNER_MODEL=
# AGENT_SYNTHESIZER_MODEL=
# AGENT_SYSTEM_PROMPT=
# An "ask" parks the turn until a person answers: POST /sessions/:id/answers/:requestId.
# AGENT_TOOL_APPROVAL=ask-writes   # autopilot (default) | read-only | ask-writes | ask-all
# AGENT_TOOL_RULES={"github__delete_*":"deny"}
# MCP_SERVERS={"docs":{"url":"https://mcp.example.com/mcp","headers":{"authorization":"Bearer ..."}}}
# Static subagents, each a tool of the agent; a call runs as a child workflow. Tools: the workers' own.
# SUBAGENTS={"researcher":{"description":"Research one question with the docs","tools":["docs__search"],"readOnly":true}}
# Their caps (read by the gateway, fixed when a session starts):
# SUBAGENT_MAX_PER_ROUND=4
# SUBAGENT_MAX_PER_SESSION=50
# Pipelines, each a tool of the agent: a graph of agents (the core's pipeline definition, JSON);
# a call runs as a child workflow, every node visit as a child workflow of its own. A node's tools
# and mcpServers are the workers' own; its model a model of AGENT_PROVIDER_TYPE.
# PIPELINES={"review":{"description":"Draft an answer and check it","definition":{"version":1,"entry":"draft","nodes":[{"id":"draft","instructions":"Write a draft."},{"id":"check","instructions":"Check it.","tools":["docs__search"]}],"edges":[{"from":"draft","to":"check"}]}}}
# Their caps (read by the gateway, fixed when a session starts):
# PIPELINE_MAX_PER_ROUND=2
# PIPELINE_MAX_PER_SESSION=20

# A rate limit shared by every worker (a token bucket in Postgres). Unset = off.
# LIMITER_REFILL_PER_SECOND=2
# LIMITER_CAPACITY=10
# LIMITER_MAX_WAIT_MS=60000

# How many workers `docker compose up` starts (or: --scale worker=N).
# WORKERS=2
