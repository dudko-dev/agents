{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-swarm values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object"
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(|sha256:[a-f0-9]{64})$"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository"
      ]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "name"
        ]
      }
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "logLevel": {
      "enum": [
        "debug",
        "info",
        "warn",
        "error"
      ]
    },
    "pgPoolMax": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "secrets": {
      "type": "object",
      "properties": {
        "databaseUrl": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ]
        },
        "migrateDatabaseUrl": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The Secret's name (empty: not used)"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ]
        },
        "gatewayTokens": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ]
        },
        "agentApiKey": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ]
        },
        "temporalApiKey": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "The Secret's name (empty: not used)"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "key"
          ]
        },
        "temporalTls": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "clientCertificate": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "name"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "databaseUrl",
        "gatewayTokens",
        "agentApiKey"
      ]
    },
    "temporal": {
      "type": "object",
      "additionalProperties": true,
      "description": "The swarm's Temporal settings; with enabled, every other key goes to the bundled Temporal chart.",
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^(|[^\\s:/]+:[0-9]{1,5})$"
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "taskQueue": {
          "type": "string",
          "minLength": 1
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "serverName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "namespace",
        "taskQueue",
        "enabled"
      ]
    },
    "session": {
      "type": "object",
      "properties": {
        "idleTimeoutMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "turnTimeoutMs": {
          "type": "integer",
          "minimum": 1000
        },
        "heartbeatTimeoutMs": {
          "type": "integer",
          "minimum": 1000
        },
        "maxTurnAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxTurnsPerRun": {
          "type": "integer",
          "minimum": 1
        },
        "historyMaxChars": {
          "type": "integer",
          "minimum": 1000
        },
        "maxQueuedMessages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "subagentMaxPerRound": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "subagentMaxPerSession": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "gateway": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "auth": {
          "enum": [
            "bearer",
            "none"
          ]
        },
        "corsOrigins": {
          "type": "string"
        },
        "maxBodyBytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 16777216
        },
        "messageMaxChars": {
          "type": "integer",
          "minimum": 1
        },
        "sse": {
          "type": "object",
          "properties": {
            "maxConnections": {
              "type": "integer",
              "minimum": 1
            },
            "keepAliveMs": {
              "type": "integer",
              "minimum": 1000
            },
            "batch": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5000
            }
          },
          "additionalProperties": false
        },
        "service": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "ClusterIP",
                "NodePort",
                "LoadBalancer"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "preStopSleepSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "terminationGracePeriodSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "minReplicas",
            "maxReplicas",
            "targetCPUUtilizationPercentage"
          ]
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "worker": {
      "type": "object",
      "properties": {
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        },
        "maxConcurrentTurns": {
          "type": "integer",
          "minimum": 1
        },
        "shutdownGraceSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "terminationExtraSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        },
        "heartbeatThrottleMs": {
          "type": "integer",
          "minimum": 100
        },
        "leaseTtlMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 2147483647
        },
        "eventMaxBytes": {
          "type": "integer",
          "minimum": 1024
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "limiter": {
          "type": "object",
          "properties": {
            "refillPerSecond": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              ]
            },
            "capacity": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 0
                },
                {
                  "type": "number",
                  "minimum": 1
                }
              ]
            },
            "maxWaitMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "scope": {
              "enum": [
                "global",
                "model"
              ]
            }
          },
          "additionalProperties": false
        },
        "autoscaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "maxReplicas": {
              "type": "integer",
              "minimum": 1
            },
            "targetCPUUtilizationPercentage": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "keda": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "minReplicaCount": {
                  "type": "integer",
                  "minimum": 0
                },
                "maxReplicaCount": {
                  "type": "integer",
                  "minimum": 1
                },
                "pollingInterval": {
                  "type": "integer",
                  "minimum": 1
                },
                "cooldownPeriod": {
                  "type": "integer",
                  "minimum": 0
                },
                "targetQueueSize": {
                  "type": "integer",
                  "minimum": 1
                },
                "activationTargetQueueSize": {
                  "type": "integer",
                  "minimum": 0
                },
                "queueTypes": {
                  "type": "string",
                  "pattern": "^(workflow|activity|nexus)(,(workflow|activity|nexus))*$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "podAnnotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "podLabels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "nodeSelector": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "topologySpreadConstraints": {
          "type": "array"
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ]
          }
        },
        "extraEnvFrom": {
          "type": "array"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "providerType": {
          "enum": [
            "openai",
            "anthropic",
            "google",
            "openai-compatible"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "baseUrl": {
          "type": "string"
        },
        "plannerModel": {
          "type": "string"
        },
        "synthesizerModel": {
          "type": "string"
        },
        "systemPrompt": {
          "type": "string"
        },
        "toolApproval": {
          "enum": [
            "autopilot",
            "read-only",
            "ask-writes",
            "ask-all"
          ]
        },
        "toolRules": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "allow",
                  "ask",
                  "deny"
                ]
              }
            }
          ]
        },
        "mcpServers": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object"
            }
          ]
        },
        "subagents": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_-]{0,47}$"
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "description": {
                    "type": "string",
                    "minLength": 1
                  },
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "systemPrompt": {
                    "type": "string",
                    "minLength": 1
                  },
                  "tools": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "maxIterations": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  "readOnly": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "description"
                ]
              }
            }
          ]
        },
        "maxIterations": {
          "type": "integer",
          "minimum": 1
        },
        "maxStepsPerTask": {
          "type": "integer",
          "minimum": 1
        },
        "logLevel": {
          "enum": [
            "none",
            "error",
            "warn",
            "info",
            "debug"
          ]
        },
        "extra": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Z][A-Z0-9_]*$"
          },
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "providerType",
        "model"
      ]
    },
    "migrate": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "automountServiceAccountToken": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gateway": {
          "type": "object",
          "properties": {
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        },
        "worker": {
          "type": "object",
          "properties": {
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "pathType": {
                      "enum": [
                        "Prefix",
                        "Exact",
                        "ImplementationSpecific"
                      ]
                    }
                  },
                  "additionalProperties": false,
                  "required": [
                    "path",
                    "pathType"
                  ]
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "host",
              "paths"
            ]
          }
        },
        "tls": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "gatewayFrom": {
          "type": "array"
        },
        "dns": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "to": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "postgres": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "to": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "temporal": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "to": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "provider": {
          "type": "object",
          "properties": {
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "minItems": 1
            },
            "to": {
              "type": "array"
            }
          },
          "additionalProperties": false
        },
        "extraWorkerEgress": {
          "type": "array"
        }
      },
      "additionalProperties": false
    },
    "podSecurityContext": {
      "type": "object",
      "properties": {
        "runAsNonRoot": {
          "const": true
        },
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        },
        "fsGroup": {
          "type": "integer",
          "minimum": 0
        },
        "seccompProfile": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "runAsNonRoot",
        "runAsUser"
      ]
    },
    "securityContext": {
      "type": "object",
      "properties": {
        "allowPrivilegeEscalation": {
          "const": false
        },
        "readOnlyRootFilesystem": {
          "const": true
        },
        "privileged": {
          "const": false
        },
        "capabilities": {
          "type": "object"
        }
      },
      "additionalProperties": true,
      "required": [
        "allowPrivilegeEscalation",
        "readOnlyRootFilesystem"
      ]
    },
    "tmp": {
      "type": "object",
      "properties": {
        "sizeLimit": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)$"
        }
      },
      "additionalProperties": false,
      "required": [
        "sizeLimit"
      ]
    }
  },
  "required": [
    "image",
    "secrets",
    "temporal",
    "session",
    "gateway",
    "worker",
    "agent"
  ]
}
