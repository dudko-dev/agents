{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "agent.dudko.dev: the landing page and the documentation, with the demo mounted under /demo/.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "node scripts/sync-docs.mjs && astro dev",
    "build": "node scripts/sync-docs.mjs && astro build --force && node scripts/assemble.mjs",
    "preview": "astro preview",
    "typecheck": "node scripts/sync-docs.mjs && astro check",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"scripts/*.mjs\" astro.config.mjs",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"scripts/*.mjs\" astro.config.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.2",
    "astro": "^7.4.13",
    "astro-expressive-code": "^0.44.4",
    "sharp": "^0.35.5",
    "starlight-llms-txt": "^0.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "demo": "workspace:*",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "worker": "workspace:*"
  },
  "nx": {
    "targets": {
      "typecheck": {
        "dependsOn": [
          "build"
        ]
      }
    }
  }
}
