/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The demo's hashed files. The pipeline editor (/pipeline/) is a page of the same build: its
# scripts and styles are here too, so this rule is the one that caches them.
/demo/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The demo's OAuth client ID metadata document (CIMD): an authorization server fetches it, server
# side, to learn who the client is. Its address IS the client's ID; short cache, so a change of
# redirect addresses reaches them within minutes.
/oauth/client.json
  Content-Type: application/json
  Cache-Control: public, max-age=300
