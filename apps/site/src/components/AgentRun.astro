---
// The hero's live widget: one agent run acted out - the request, the plan, the tool calls of each
// step, the answer, the tokens it cost. It is ordinary markup (a crawler and a screen reader get
// the whole run as text); a small script replays it in order. With reduced motion, or without
// JavaScript, the finished run is simply shown.
const steps = [
  {
    title: 'Find the pricing page',
    calls: [{ name: 'docs__search', arg: '"pricing"', result: '3 pages' }],
  },
  {
    title: 'Read the tiers',
    calls: [
      { name: 'web_fetch', arg: 'example.com/pricing', result: '200 · 4.1 kB' },
      { name: 'web_fetch', arg: 'example.com/pricing/enterprise', result: '200 · 2.7 kB' },
    ],
  },
  {
    title: 'Compare and summarise',
    calls: [],
  },
]
const answer =
  'There are three tiers. Starter is free for one project. Team is $24 per seat and adds SSO and audit logs. Enterprise is priced on request and adds a dedicated region.'
---

<figure class="run" data-run aria-label="An example run of the agent">
  <div class="run__bar" aria-hidden="true">
    <span></span><span></span><span></span>
    <p class="run__status" data-status>done</p>
  </div>

  <div class="run__body">
    <p class="run__goal" data-part="goal">
      <span class="run__who">You</span>
      Find the latest pricing page and summarise the tiers.
    </p>

    <ol class="run__plan" role="list">
      {
        steps.map((step, i) => (
          <li class="step" data-part="step" data-index={i}>
            <p class="step__title">
              <span class="step__mark" aria-hidden="true" />
              {step.title}
            </p>
            {step.calls.length > 0 && (
              <ul class="step__calls" role="list">
                {step.calls.map((call) => (
                  <li class="call" data-part="call">
                    <code>
                      {call.name}
                      <span class="call__arg">({call.arg})</span>
                    </code>
                    <span class="call__result">{call.result}</span>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>

    <p class="run__answer" data-part="answer">
      <span class="run__who">Agent</span>
      <span data-answer>{answer}</span>
    </p>
  </div>

  <figcaption class="run__meta" data-part="meta">
    <span>3 steps · 3 tool calls</span>
    <span>in 12.4k · out 486 · 4.2 s</span>
  </figcaption>
</figure>

<style>
  .run {
    margin: 0;
    border: 1px solid var(--c-border-strong);
    border-radius: var(--radius-lg);
    background: var(--c-surface);
    box-shadow: var(--shadow-lift);
    font-size: var(--text-sm);
    overflow: hidden;
  }
  .run__bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--c-border);
  }
  .run__bar span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: var(--c-border-strong);
  }
  .run__status {
    margin: 0 0 0 auto;
    color: var(--c-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .run__body {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-6);
    /* The height never changes while the run replays: nothing below the hero moves. */
    min-height: 23rem;
    align-content: start;
  }
  .run__who {
    display: block;
    margin-bottom: var(--space-1);
    color: var(--c-text-faint);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .run__goal,
  .run__answer {
    margin: 0;
    line-height: var(--leading-normal);
  }
  .run__answer [data-answer] {
    display: block;
  }
  .run__answer {
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--c-surface-2);
  }
  .run__plan {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0 0 0 var(--space-4);
    border-left: 1px solid var(--c-border-strong);
    list-style: none;
  }
  .step__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-weight: 600;
  }
  .step__mark {
    flex: none;
    width: 0.875rem;
    height: 0.875rem;
    border: 2px solid var(--c-ok);
    border-radius: 50%;
    background: var(--c-ok);
    transition:
      background-color var(--dur-fast) var(--ease-settle),
      border-color var(--dur-fast) var(--ease-settle);
  }
  .step[data-state='todo'] .step__mark {
    border-color: var(--c-border-strong);
    background: transparent;
  }
  .step[data-state='doing'] .step__mark {
    border-color: var(--c-accent);
    background: transparent;
    animation: pulse 1.2s var(--ease-settle) infinite;
  }
  .step[data-state='todo'] .step__title {
    color: var(--c-text-muted);
  }
  .step__calls {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-2) 0 0;
    padding: 0 0 0 var(--space-6);
    list-style: none;
  }
  .call {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-sm);
    background: var(--c-code-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .call code {
    color: var(--c-accent-strong);
    overflow-wrap: anywhere;
  }
  .call__arg {
    color: var(--c-text-muted);
  }
  .call__result {
    color: var(--c-ok);
  }
  .run__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    border-top: 1px solid var(--c-border);
    color: var(--c-text-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  /* While the script replays the run, a part that has not happened yet is held back and then
     settles into place - the page's motion signature. */
  .run[data-playing] [data-part] {
    transition:
      opacity var(--dur-base) var(--ease-settle),
      transform var(--dur-base) var(--ease-settle);
  }
  .run[data-playing] [data-part][data-hidden] {
    opacity: 0;
    transform: translateY(var(--space-3));
  }
  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 var(--c-accent-soft);
    }
    50% {
      box-shadow: 0 0 0 0.375rem var(--c-accent-soft);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .step[data-state='doing'] .step__mark {
      animation: none;
    }
  }
</style>

<script>
  const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms))

  const play = async (root: HTMLElement, alive: () => boolean) => {
    const status = root.querySelector<HTMLElement>('[data-status]')!
    const goal = root.querySelector<HTMLElement>('[data-part="goal"]')!
    const steps = [...root.querySelectorAll<HTMLElement>('[data-part="step"]')]
    const answer = root.querySelector<HTMLElement>('[data-part="answer"]')!
    const answerText = root.querySelector<HTMLElement>('[data-answer]')!
    const meta = root.querySelector<HTMLElement>('[data-part="meta"]')!
    const full = answerText.dataset.full ?? (answerText.dataset.full = answerText.textContent ?? '')
    const say = (text: string) => (status.textContent = text)
    const wait = async (ms: number) => {
      await sleep(ms)
      if (!alive()) throw new Error('stopped')
    }

    // Reset to "nothing has happened yet".
    for (const part of root.querySelectorAll<HTMLElement>('[data-part]')) part.dataset.hidden = ''
    for (const step of steps) step.dataset.state = 'todo'
    // The answer is typed out word by word; its box keeps the height of the full text meanwhile,
    // measured afresh each replay (the width may have changed), so nothing below ever moves.
    answerText.style.minHeight = ''
    answerText.textContent = full
    answerText.style.minHeight = `${answerText.offsetHeight}px`
    answerText.textContent = ''
    say('waiting')
    await wait(500)

    delete goal.dataset.hidden
    await wait(900)

    say('planning')
    for (const step of steps) {
      delete step.dataset.hidden
      await wait(260)
    }
    await wait(500)

    for (const [i, step] of steps.entries()) {
      say(`step ${i + 1} of ${steps.length}`)
      step.dataset.state = 'doing'
      for (const call of step.querySelectorAll<HTMLElement>('[data-part="call"]')) {
        await wait(520)
        delete call.dataset.hidden
      }
      await wait(700)
      step.dataset.state = 'done'
    }

    say('answering')
    delete answer.dataset.hidden
    const words = full.split(' ')
    for (let i = 1; i <= words.length; i++) {
      answerText.textContent = words.slice(0, i).join(' ')
      await wait(55)
    }
    delete meta.dataset.hidden
    say('done')
    await wait(5200)
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-run]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue
    let visible = false
    let running = false
    const loop = async () => {
      if (running) return
      running = true
      root.dataset.playing = ''
      try {
        while (visible && !document.hidden) await play(root, () => visible && !document.hidden)
      } catch {
        /* left the screen mid-run: stop where it is, start over when it comes back */
      }
      running = false
    }
    new IntersectionObserver(
      ([entry]) => {
        visible = Boolean(entry?.isIntersecting)
        if (visible) void loop()
      },
      { threshold: 0.35 },
    ).observe(root)
    document.addEventListener('visibilitychange', () => {
      if (visible && !document.hidden) void loop()
    })
  }
</script>
