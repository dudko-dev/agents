---
import '../styles/tokens.css'
import '../styles/site.css'
import markRaw from '../assets/mark.svg?raw'
import { REPO, SITE } from '../data/site'

interface Props {
  title: string
  description: string
  /** Path of this page, with its trailing slash: the canonical address. */
  path: string
  jsonLd?: object[]
  noindex?: boolean
}
const { title, description, path, jsonLd = [], noindex = false } = Astro.props
const canonical = new URL(path, SITE).href
const year = new Date().getFullYear()
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#04070e" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dudko.dev agents" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={`${SITE}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="dudko.dev agents: planning AI agents for Node and the browser" />
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="nav__bar">
        <a class="nav__brand" href="/" aria-label="dudko.dev agents, home">
          <span class="nav__mark" aria-hidden="true" set:html={markRaw} />
          <span>agents</span>
        </a>
        <nav class="nav__links" aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="/demo/" data-astro-reload>Demo</a>
          <a href={REPO}>GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="wrap footer__grid">
        <div>
          <a class="nav__brand" href="/" aria-label="dudko.dev agents, home">
            <span class="nav__mark" aria-hidden="true" set:html={markRaw} />
            <span>agents</span>
          </a>
          <p class="footer__note">
            MIT licensed. © {year} <a href="https://dudko.dev">Siarhei Dudko</a>.
          </p>
        </div>
        <nav class="footer__links" aria-label="Footer">
          <a href="/docs/node/">Node agent</a>
          <a href="/docs/browser/">Browser agent</a>
          <a href="/docs/react/">React bindings</a>
          <a href="/docs/browser/security/">Security</a>
          <a href="/demo/" data-astro-reload>Live demo</a>
          <a href={REPO}>GitHub</a>
          <a href="https://www.npmjs.com/org/dudko.dev">npm</a>
          <a href="/license/">License</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
