// The demo's MCP Apps sandbox page, on a domain of its own: https://agent-demo-apps.dudko.dev.
// A SEPARATE Worker from the site's (root wrangler.jsonc), deployed by a Workers Builds project of
// its own (README.md: `pnpm nx build app-sandbox`, then
// `npx wrangler deploy --config apps/app-sandbox/wrangler.jsonc`). It serves
// /sandbox/v1/<policy> and nothing else: no assets, no binding, no secret, no state.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Workers Builds wants the Worker's name in the dashboard to be this one.
  "name": "agent-demo-apps",
  "compatibility_date": "2026-11-01",
  "main": "./dist/index.js",
  // One origin: the Custom Domain below. Not *.workers.dev, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agent-demo-apps.dudko.dev", "custom_domain": true }],
  "vars": {
    // Who may frame the page and hand it an app: the site, and its Cloudflare previews
    // (`<version>-agents.dudko.workers.dev`). A `*` stands for ONE label fragment in the page's
    // script; `frame-ancestors` cannot say that and is widened to https://*.dudko.workers.dev.
    "ALLOWED_HOST_ORIGINS": "https://agent.dudko.dev https://*-agents.dudko.workers.dev"
  },
  // Workers Builds refuses a non-production build without this block (it may stay empty).
  "previews": {}
}
