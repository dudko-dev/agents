# Copy to .env: `cp env.example .env`

# Required - the model the executor runs.
AGENT_MODEL=gemini-3.1-flash-lite-preview

# Optional separate model for the planner and replanner.
# Falls back to AGENT_MODEL when unset.
AGENT_PLANNER_MODEL=gemini-3.1-flash-lite-preview

# Optional separate model for the final answer synthesizer.
# Falls back to AGENT_MODEL when unset. It can make sense to put a larger
# model here when the executor is a small tool-calling model.
# AGENT_SYNTHESIZER_MODEL=gemini-3.1-flash-lite-preview

# Executor models by tier (optional). With either set, the planner rates every step low / medium /
# high and the executor runs it on the light / standard (AGENT_MODEL) / strong model. A tier that
# is not set falls back to the nearest one that is. Each also takes _PROVIDER_TYPE / _BASE_URL /
# _API_KEY / _PROVIDER_OPTIONS, like the planner block below.
# AGENT_EXECUTOR_LIGHT_MODEL=gemini-3.1-flash-lite-preview
# AGENT_EXECUTOR_STRONG_MODEL=gemini-3.1-pro-preview
#
# With tier models, a step that fails in a way a stronger model could fix (a blocker, no result,
# tool arguments that keep failing to parse, output cut by the cap) is retried once on the next
# stronger tier before the replanner is asked. off = never.
# AGENT_ESCALATION=off
# AGENT_ESCALATION_MAX_PER_STEP=1
# AGENT_ESCALATION_MAX_PER_RUN=3

# Per-stage provider override (advanced). Use these when the planner or
# synthesizer should run on a DIFFERENT provider / endpoint / API key than
# the executor. Each block is fully optional - omit a variable to inherit
# the top-level AGENT_* default.
#
# Cross-provider override caveat: setting AGENT_PLANNER_PROVIDER_TYPE to a
# different vendor than AGENT_PROVIDER_TYPE requires AGENT_PLANNER_API_KEY
# (the agent refuses to inherit a key across vendors).
#
# AGENT_PLANNER_PROVIDER_TYPE=anthropic
# AGENT_PLANNER_BASE_URL=
# AGENT_PLANNER_API_KEY=sk-ant-...
#
# AGENT_SYNTHESIZER_PROVIDER_TYPE=openai
# AGENT_SYNTHESIZER_BASE_URL=
# AGENT_SYNTHESIZER_API_KEY=sk-...

# Provider type. Each provider's SDK is an OPTIONAL peerDependency: install
# only the one(s) you actually use. Available:
#   openai             @ai-sdk/openai
#   anthropic          @ai-sdk/anthropic
#   google             @ai-sdk/google         (Gemini native - PREFER for Gemini)
#   openai-compatible  @ai-sdk/openai-compatible (vLLM / Ollama / any OpenAI-spec server)
#   xai                @ai-sdk/xai            (Grok)
#   azure              @ai-sdk/azure
#   amazon-bedrock     @ai-sdk/amazon-bedrock
#   google-vertex      @ai-sdk/google-vertex
#   deepseek           @ai-sdk/deepseek
#   gateway            (ships inside `ai` - no extra package)
#   cloudflare         workers-ai-provider
#
# For Gemini USE google (the native API): the OpenAI-compat endpoint is broken
# for structured outputs (responseFormat is ignored) and for streamed
# tool_calls (the `index` field is missing). The google provider hits the
# native API directly and behaves correctly.
AGENT_PROVIDER_TYPE=google
# Optional for openai/anthropic/google/xai/deepseek/gateway/amazon-bedrock/
# google-vertex/cloudflare (the SDK default endpoint is used); REQUIRED for
# openai-compatible and azure (point at your deployment URL).
# AGENT_BASE_URL=
AGENT_API_KEY=replace-me

# Provider-specific extras forwarded to the SDK factory. Set as a JSON
# object - whatever you put in here is spread into the create*() call after
# baseURL / apiKey, so anything documented for the underlying SDK works:
#   azure          -> { "apiVersion": "2024-08-01-preview", "resourceName": "..." }
#   amazon-bedrock -> { "region": "us-east-1", "accessKeyId": "...", "secretAccessKey": "..." }
#   google-vertex  -> { "project": "my-proj", "location": "us-central1" }
#   cloudflare     -> { "accountId": "..." }
# Per-stage equivalents: AGENT_PLANNER_PROVIDER_OPTIONS, AGENT_SYNTHESIZER_PROVIDER_OPTIONS.
# AGENT_PROVIDER_OPTIONS={"region":"us-east-1"}
#
# Plain env-var fallbacks for the most common cases (used only when the
# corresponding key is absent from AGENT_PROVIDER_OPTIONS):
#
# cloudflare: account ID. CLOUDFLARE_ACCOUNT_ID is the standard fallback.
# CLOUDFLARE_ACCOUNT_ID=
#
# amazon-bedrock: AGENT_API_KEY is forwarded as a Bearer token. Without it
# the SDK falls back to AWS_REGION + AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY.
# AWS_REGION=us-east-1
#
# google-vertex: AGENT_API_KEY is IGNORED (Vertex uses Google ADC, not an
# API key string). Auth is picked up from the environment:
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Client name (forwarded as User-Agent on MCP/provider requests).
AGENT_CLIENT_NAME=vercel-mcp-test

# none | error | warn | info | debug
AGENT_LOG_LEVEL=info

# Cap on plan/execute/replan iterations. Guards against runaway loops.
AGENT_MAX_ITERATIONS=10

# Cap on LLM steps inside a single executor call (multi-step tool calling).
# A `tool-call -> tool-result -> assistant-message` cycle counts as 2 steps.
# Sensible minimum is 2 (one tool + final answer); recommended 6-10.
AGENT_MAX_STEPS_PER_TASK=8

# Per-LLM-call timeout (planner / executor / replanner / synthesizer), in ms.
# 0 or empty disables the timeout. 60000-120000 is recommended in production.
# The executor's covers a whole step; it stops while you answer a tool approval
# or an MCP question, and goes on with the time it had left.
# AGENT_LLM_TIMEOUT_MS=90000

# How many times to retry an LLM call on 5xx / 429 / network errors. Default 2.
# AGENT_LLM_MAX_RETRIES=2

# Cap on the number of "revise" decisions the replanner can make per run.
# Prevents the LLM from looping in "revise -> execute -> revise". Default 2.
# AGENT_MAX_REVISIONS=2

# Per-run token caps. When one is crossed (checked between steps AND at every
# LLM step inside an executor step) the agent stops executing steps and
# synthesizes the final answer from what it has.
# AGENT_MAX_TOTAL_TOKENS=200000      # input + output
# AGENT_MAX_INPUT_TOKENS=150000
# AGENT_MAX_OUTPUT_TOKENS=30000      # includes reasoning
# AGENT_MAX_REASONING_TOKENS=20000

# Output cap of ONE LLM call per stage (planner, executor, replanner, synthesizer, compaction), as
# JSON. Left out, a stage gets a share of AGENT_CONTEXT_WINDOW_TOKENS between a floor and a ceiling
# (128k window: planner 2000, executor 8000, replanner 1000, synthesizer 4000); a stage that thinks
# gets none. 0 = no cap at all. A call the cap cuts off is reported as a warning.
# AGENT_PER_CALL_TOKENS={"executor":16000,"synthesizer":0}

# Cap on tool calls per run (across steps). Further calls fail with
# "tool-call budget exhausted" and the run goes to the final answer.
# AGENT_MAX_TOOL_CALLS=40

# Thinking / reasoning for every stage:
#   off                      explicitly disabled
#   minimal|low|medium|high|xhigh   portable effort level
#   provider-default         the provider's default level
#   <number>                 an exact budget in tokens (Anthropic / Google)
# Unset: nothing is sent (the provider's default behaviour).
# AGENT_THINKING=medium

# Tool approval (consent) mode:
#   autopilot (default)  every tool call runs
#   ask-writes           read-only tools run, others ask at the REPL prompt
#   ask-all              every call asks
#   read-only            read-only tools run, others are denied
# Answer y / n / a(lways) at the prompt; /autopilot toggles at runtime and
# /approval <mode> switches modes. A question nobody answers within 5 minutes is
# denied and the prompt is closed with one line (Ctrl-C closes it with the run).
# AGENT_TOOL_APPROVAL=ask-writes

# MCP elicitation: let a connected MCP server ask YOU something in the middle of a tool call.
#   off (default)  no capability is declared: a server cannot ask
#   form           a server may ask for a form; its fields are put at the REPL prompt one by one
#   all            also URL mode: the link is printed for you to open yourself (nothing opens it)
# The question is the server's text (printed as a quotation); what you answer goes to that
# server only - never to the model, the log or a trace. A question waits 5 minutes at most, a
# tool call may ask 5 and a run 20. Helpers started with AGENT_SUBAGENTS cannot ask.
# AGENT_MCP_ELICITATION=form

# Per-tool rules, the permissions block of a settings file: a JSON object of
# tool names (exact, or with '*' globs) to allow | ask | deny. The most specific
# match wins (exact beats the longest glob) and it beats the mode above, so a
# rule holds even under autopilot. A typo in a value is an error at startup.
# AGENT_TOOL_RULES={"github__delete_*":"deny","docs__*":"allow"}

# Outbound requests the MODEL may make (the web_fetch tool). Off by default: with it off the
# agent has no way to reach the network except through the tools and MCP servers you configure.
# on = any public host over https. Requests go through a safe fetch: its own DNS lookup, private
# / loopback / link-local / cloud-metadata addresses refused, redirects re-checked, size and
# time bounded. Narrow it with an allow list (then only those hosts, and web_fetch counts as
# read-only for tool approval) and/or a deny list (wins over allow). Entries: example.com,
# *.example.com (subdomains), an IP or a CIDR. Setting these while AGENT_EGRESS is off is an error.
# AGENT_EGRESS=on
# AGENT_EGRESS_ALLOW=docs.example.com,*.github.com
# AGENT_EGRESS_DENY=internal.example.com,10.0.0.0/8
# AGENT_EGRESS_PROTOCOLS=https
# AGENT_EGRESS_ALLOW_PRIVATE=off

# Let the model SEARCH the web (the web_search tool: a short list of title / url / snippet). Off
# by default. The CLI offers one provider: google - Google Search through Gemini grounding. It
# needs a Gemini (Google AI Studio) API key and nothing else: when the agent itself runs on Gemini
# (AGENT_PROVIDER_TYPE=google) AGENT_API_KEY is used, otherwise set AGENT_SEARCH_API_KEY.
# Every search is one extra model call (generateContent with the google_search tool) and spends
# that model's tokens; they are counted in the run's usage. Result URLs are Google redirect links
# (vertexaisearch.cloud.google.com/grounding-api-redirect/...), not the pages' own addresses: with
# AGENT_EGRESS_ALLOW set, list that host too or every result is left out - web_fetch follows the
# link and each hop is judged again. Measured 2026-11-26 on free-tier keys: gemini-2.5-flash-lite
# and gemini-2.5-flash answered with grounding (not on keys of new accounts: HTTP 404);
# gemini-3.1-flash-lite, gemini-3.5-flash-lite and gemini-3.8-flash answered HTTP 429 (no quota).
# The free tier that answered allowed 20 requests a day per model and key - a search is one.
# The request goes through the same safe fetch as web_fetch and can reach only that API's host.
# Queries leave for Google: do not enable it where a query may carry data that must stay inside.
# Any other search API (Brave, Tavily, SearXNG, ...) is a function in code: see "Search engine
# recipes" in the README.
# AGENT_SEARCH=google           # google | off
# AGENT_SEARCH_API_KEY=         # a Gemini API key (AIza...)
# AGENT_SEARCH_MODEL=gemini-2.5-flash-lite
# AGENT_SEARCH_BASE_URL=        # a gateway of yours in place of generativelanguage.googleapis.com
# AGENT_SEARCH_MAX_RESULTS=5    # 1..10
# AGENT_SEARCH_ALLOW_PRIVATE=off  # on = that gateway may be on a private address

# Images, speech and transcription. Off by default; each model id mounts its own tool:
#   AGENT_IMAGE_MODEL          -> generate_image  (a prompt becomes an image file)
#   AGENT_SPEECH_MODEL         -> generate_speech (text becomes an audio file)
#   AGENT_TRANSCRIPTION_MODEL  -> transcribe_audio, and /audio <file> [question] in the REPL:
#                                 the file is transcribed once and the model reads the text
# The models run on the main provider (AGENT_PROVIDER_TYPE / AGENT_API_KEY) unless the
# AGENT_MEDIA_* block names another - Anthropic, for one, has no image or speech models.
# Generated files are written to AGENT_MEDIA_DIR and the model is told the path, never the
# bytes. Every call costs money: it counts as a write for tool approval, shows in /usage, and a
# run may make AGENT_MEDIA_MAX_CALLS of them. Prompts, the text to speak and the audio leave for
# that provider: do not enable it where they may carry data that must stay inside.
# AGENT_IMAGE_MODEL=gpt-image-1
# AGENT_SPEECH_MODEL=gpt-4o-mini-tts
# AGENT_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# AGENT_MEDIA_PROVIDER_TYPE=openai
# AGENT_MEDIA_API_KEY=
# AGENT_MEDIA_BASE_URL=
# AGENT_MEDIA_DIR=./agent-media
# AGENT_MEDIA_MAX_CALLS=8       # 0 = no cap
# AGENT_SPEECH_VOICE=alloy

# Let the model RUN JavaScript it wrote (the run_js tool) and read the real output, instead of
# describing what the code would print. Off by default. The code runs in QuickJS compiled to
# WebAssembly inside a worker thread that is killed at the deadline: no network, no files, no
# process, no packages. Needs the optional package: npm install quickjs-emscripten.
# A run counts as a write for tool approval. Setting the limits while AGENT_SANDBOX is off is an error.
# AGENT_SANDBOX=on
# AGENT_SANDBOX_TIMEOUT_MS=5000
# AGENT_SANDBOX_MEMORY_MB=32

# Let the model start helper agents itself (the spawn_subagent tool): it hands a self-contained
# sub-task to a helper, optionally with a subset of its own tools, and gets the answer back. Off
# by default. A helper can only have less than the run that starts it - its tools (the read-only
# ones unless the model names others), a share of what is left of its token and tool-call
# budgets, the same models and the same approval mode and rules - and what it spends counts
# against the run's limits. /agents and /stop list and stop helpers while a run goes.
# Setting the limits while AGENT_SUBAGENTS is off is an error.
# AGENT_SUBAGENTS=on
# AGENT_SUBAGENTS_MAX_DEPTH=1        # 1 = helpers cannot start helpers; at most 4
# AGENT_SUBAGENTS_MAX_CHILDREN=8     # helpers one run may start in all
# AGENT_SUBAGENTS_MAX_CONCURRENT=3   # helpers of one parent running at once

# Let the agent keep a notebook: when it hits a problem and finds the way around it, it writes
# the lesson down as a skill (name, when to use it, the steps that worked) that the planner and
# executor see for the rest of the session. Saving counts as a write for tool approval, nothing
# that looks like a credential is stored, and an operator's own skills are never overwritten.
# AGENT_LEARNING_DIR keeps the lessons as <dir>/<name>/SKILL.md across sessions (you can read,
# edit or delete them); without it they last as long as the REPL.
# AGENT_LEARNING=on
# AGENT_LEARNING_DIR=./learned-skills

# Folder of agentskills.io-style skills: <dir>/<skill>/SKILL.md (+ bundled
# text files). The planner picks the ones that apply; the executor can load
# any with load_skill.
# AGENT_SKILLS_DIR=./skills

# Compaction: history / trace summaries kick in at 50% of the context window.
# AGENT_COMPACTION=off disables the automatic part (/compact still works).
# AGENT_CONTEXT_WINDOW_TOKENS=128000
# AGENT_COMPACTION_THRESHOLD is the percent of the window at which auto-compaction starts (default 85).
# It is judged on the whole context: system prompt, tool definitions and skills + history + trace.
# AGENT_COMPACTION_THRESHOLD=85
# AGENT_COMPACTION=on

# Tool selection strategy for the executor:
# - auto (default)        'all' up to 40 tools, 'search' above.
# - all                   every step sees the full filtered ToolSet.
#                         Works well with <=40 tools.
# - plan-narrowed         executor gets only the tools listed in
#                         step.suggestedTools. The planner MUST populate
#                         suggestedTools for every step that needs tools.
# - search                each step starts with the suggested tools and the
#                         ones found earlier, plus find_tools, which searches
#                         the whole catalogue and activates matches. For
#                         catalogues of hundreds of tools.
# AGENT_TOOL_SELECTION_STRATEGY=auto

# Fine-grained MCP tool control. Names use the `serverName__toolName` format.
# availableTools wins over excludedTools.
# AGENT_AVAILABLE_TOOLS=demo__list_companies,demo__get_company
# AGENT_EXCLUDED_TOOLS=

# MCP servers. JSON: Record<name, { url, headers?, protocol?, skills?, connectTimeoutMs? } |
#   { command, args?, env?, cwd?, protocol?, skills?, connectTimeoutMs? }>.
# headers.Authorization: 'Bearer <token>' for pre-baked authorization.
# protocol (per server): legacy (default; the 2025 revisions) | auto (2026-07-28 when the
# server offers it, the 2025 ones otherwise) | modern (2026-07-28 only).
# skills (per server, EXPERIMENTAL - the MCP Skills extension): true, or {"consent": "..."} with
# once-per-skill (default: you are asked at the prompt the first time each skill would reach the
# model) | ask (every task that loads it) | never (a server you vetted). Needs protocol auto or
# modern - refused at start otherwise. connectTimeoutMs (per server): default 30000, 0 = no bound.
# Examples:
# MCP_SERVERS={"demo":{"url":"https://mcp.example.com/mcp","protocol":"auto"}}
# MCP_SERVERS={"docs":{"url":"https://docs.example.com/mcp","protocol":"auto","skills":true}}
MCP_SERVERS={"demo":{"url":"https://mcp.miniaccountant.app/v1beta"}}
