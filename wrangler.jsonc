// Cloudflare Workers (static assets) for https://agent.dudko.dev: `pnpm nx build site` builds the
// libraries, the demo and the site, and writes everything into apps/site/dist - the landing page
// and the docs at the root, the demo under /demo/. The build runs on Cloudflare (Workers Builds);
// there is no Worker script, only files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agents",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/site/dist",
    // An unknown path answers 404 with the site's own 404 page, not a soft 200.
    "not_found_handling": "404-page"
  },
  // Pull requests get a preview: Workers Builds runs `npx wrangler preview` for them, and that
  // command refuses to run without this block (it may stay empty).
  "previews": {}
}
