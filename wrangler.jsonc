// Cloudflare Workers (static assets) for https://agent.dudko.dev: `pnpm nx build demo` writes the
// site into apps/demo/dist - the demo under /demo/ and a `_redirects` file that sends the root
// there. The build runs on Cloudflare (Workers Builds); there is no Worker script, only files.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agents",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./apps/demo/dist"
  }
}
